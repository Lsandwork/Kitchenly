# Kitchen Friend — copy to .env.local and fill in what you have.
# The app runs without paid APIs. Integrations appear only when configured.

# --- App ---
APP_URL=http://localhost:3000
AUTH_SECRET=
ADMIN_PASSWORD=

# PostgreSQL (Supabase in production). Local can use the same remote DB or any Postgres.
# Pooler (recommended on Vercel):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL=

# How long kitchen scan images are kept (days). Users can delete sooner.
SCAN_RETENTION_DAYS=7

# --- AI (optional, server-side only) ---
# Route work to production OpenAI models with vision support.
# gpt-4o reads kitchen photos. Do not use placeholder/internal model names.
AI_PROVIDER=openai
AI_VISION_MODEL=gpt-4o
AI_REASONING_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-large

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Recipe retrieval (optional) ---
# TheMealDB test key "1" is used when unset. Premium key unlocks multi-ingredient filter.
THEMEALDB_API_KEY=1
SPOONACULAR_API_KEY=

# --- Local shopping (optional) ---
# Instacart Developer Platform — recipe + shopping list pages.
# Production: https://connect.instacart.com
# Development: https://connect.dev.instacart.tools
INSTACART_API_KEY=
INSTACART_API_BASE=https://connect.instacart.com

# DoorDash Marketplace (approval-based). Adapter is present; unused without credentials.
DOORDASH_API_KEY=
DOORDASH_CLIENT_ID=
DOORDASH_CLIENT_SECRET=
DOORDASH_API_BASE=

# Uber Eats Marketplace (partner approval). Adapter is present; unused without credentials.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_API_BASE=

# Google Places API (New) — nearby store discovery. Never invent inventory.
GOOGLE_MAPS_API_KEY=

# --- Object storage (optional; local disk used when unset) ---
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# --- Email (optional) ---
# Resend: https://resend.com — without this key, email actions offer mailto + copy fallback.
RESEND_API_KEY=
EMAIL_FROM=Kitchen Friend <onboarding@resend.dev>
